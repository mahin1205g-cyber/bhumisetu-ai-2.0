# LandGuard AI / Bhumisetu - Environment Configuration
# Copy this file to .env in the project root (backend loads it automatically
# when python-dotenv is installed). Never commit the real .env file.

APP_ENV=development
APP_NAME=LandGuard AI
PORT=8000
HOST=127.0.0.1
LANDTECH_DB=landtech.db
JWT_SECRET=demo-secret-key-change-in-production-2026-hackathon
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# AI assistant provider (server-side only - never expose these to the browser)
# ---------------------------------------------------------------------------
# Preferred: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternative: OpenAI or any OpenAI-compatible endpoint
# (OpenAI, Groq, DeepSeek, OpenRouter, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: force a provider when both keys are set ("gemini" or "openai")
LLM_PROVIDER=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024
